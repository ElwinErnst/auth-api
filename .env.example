PORT=3001

AUTH_JWT_ISSUER=auth
AUTH_JWT_AUDIENCE=zerotrust-api

AUTH_JWT_ACCESS_SECRET=change-me-access-secret
AUTH_JWT_REFRESH_SECRET=change-me-refresh-secret

AUTH_JWT_ACCESS_EXPIRES_IN=15m
AUTH_JWT_REFRESH_EXPIRES_IN=7d

AUTH_BCRYPT_ROUNDS=12
AUTH_INTERNAL_SERVICE_SECRET=change-me-internal-secret
AUTH_INTERNAL_HMAC_SECRET=change-me-internal-hmac-secret
# Generate a private 32-byte key with: openssl rand -base64 32
AUTH_PROVISIONING_SECRET_ENCRYPTION_KEY=<private-32-byte-base64-key>

WEBAUTHN_AUTHENTICATION_BEGIN_MIN_DURATION_MS=250
